POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=entrevista

# Docker: `db` es el hostname del servicio definido en docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@db/entrevista?sslmode=disable

# Binario nativo contra un Postgres del host (descomentar y comentar la de arriba):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/entrevista?sslmode=disable
